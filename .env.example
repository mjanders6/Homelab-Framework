HOSTNAME=
TIMEZONE=UTC
DOMAIN=

# Shared LAN settings
NETWORK_GATEWAY=
NETWORK_NAMESERVER=
NETWORK_PREFIX_LENGTH=24
NETWORK_PROBE_IP=

# pi5 - command node / management host
PI5_MAC=
PI5_IP=

# pi4_network - networking node
PI4_NETWORK_MAC=
PI4_NETWORK_IP=

# pi4_monitor - monitoring node
PI4_MONITOR_MAC=
PI4_MONITOR_IP=

# pi4_backup - backup node
PI4_BACKUP_MAC=
PI4_BACKUP_IP=

# siyuan module
SIYUAN_IMAGE=b3log/siyuan:latest
SIYUAN_CONTAINER_NAME=siyuan
SIYUAN_PORT=6806
SIYUAN_WORKSPACE_PATH=/srv/samba/siyuan-workspace
SIYUAN_ACCESS_AUTH_CODE=
SAMBA_SHARE_NAME=siyuan-workspace
SAMBA_VALID_GROUP=siyuan-users
