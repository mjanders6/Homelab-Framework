HOSTNAME=
TIMEZONE=UTC
DOMAIN=

# Shared LAN settings
NETWORK_GATEWAY=
NETWORK_NAMESERVER=
NETWORK_PREFIX_LENGTH=24
NETWORK_PROBE_IP=

# pi5 - command node / management host
RPI3_SERVER_MAC=
RPI3_SERVER_IP=
RPI3_SERVER_ROLE=pi5

# pi4_network - networking node
RPI2_SERVER_MAC=
RPI2_SERVER_IP=
RPI2_SERVER_ROLE=pi4_network

# pi4_monitor - monitoring node
RPI1_SERVER_MAC=
RPI1_SERVER_IP=
RPI1_SERVER_ROLE=pi4_monitor

# pi4_backup - backup node
RPI0_SERVER_MAC=
RPI0_SERVER_IP=
RPI0_SERVER_ROLE=pi4_backup

# desktop - infrastructure host
TOWER_SERVER_IP=
TOWER_SERVER_ROLE=desktop

# siyuan module
SIYUAN_IMAGE=b3log/siyuan:latest
SIYUAN_CONTAINER_NAME=siyuan
SIYUAN_PORT=6806
SIYUAN_WORKSPACE_PATH=/srv/samba/siyuan-workspace
SIYUAN_ACCESS_AUTH_CODE=
SAMBA_SHARE_NAME=siyuan-workspace
SAMBA_VALID_GROUP=siyuan-users
