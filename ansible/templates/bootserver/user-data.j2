#cloud-config
users:
  - default
  - name: ubuntu
    gecos: Ubuntu
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys: []

package_update: true
package_upgrade: true
packages:
{% for pkg in node_packages | default(['curl', 'jq', 'net-tools', 'openssh-server']) %}
  - {{ pkg }}
{% endfor %}

write_files:
  - path: /etc/hostname
    content: {{ node_name | to_json }}
    permissions: '0644'
  - path: /etc/hosts
    content: |
      127.0.0.1 localhost
      {{ node_static_ip }} {{ node_name }}
    permissions: '0644'

runcmd:
  - [ sh, -c, 'echo "cloud-init completed on {{ node_name }}" > /var/log/cloud-init-complete.log' ]
{% for cmd in node_runcmd | default([]) %}
  - {{ cmd }}
{% endfor %}
  - systemctl enable ssh
  - systemctl restart ssh
